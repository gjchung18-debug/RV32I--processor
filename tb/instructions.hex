FFF00093   // 00: addi x1, x0, -1        -> x1 = 0xFFFFFFFF (sign-extension check)
00200113   // 04: addi x2, x0, 2         -> x2 = 0x00000002 (shift/compare operand)
0020A1B3   // 08: slt  x3, x1, x2        -> x3 = 0x00000001 (signed: -1 < 2 -> true)
0020B233   // 0C: sltu x4, x1, x2        -> x4 = 0x00000000 (unsigned: 4.29B < 2 -> false)
0020D2B3   // 10: srl  x5, x1, x2        -> x5 = 0x3FFFFFFF (logical: zero-fill from MSB)
4020D333   // 14: sra  x6, x1, x2        -> x6 = 0xFFFFFFFF (arithmetic: sign-fill from MSB)

